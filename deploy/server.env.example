# Copy to deploy/server.env (git-ignored: it is machine-specific) and edit.
# Inside the container the library is always /data and the app listens on 0.0.0.0:8420;
# compose publishes that on the server's 127.0.0.1 only.

# The names you open the app with. Must include your Tailscale name once remote access is on.
# Comma-separated, no quotes or spaces.
PA_ALLOWED_HOSTS=127.0.0.1,localhost,photos.example-tailnet.ts.net

PA_LOG_LEVEL=INFO
PA_MIN_FREE_GB=10
PA_VIPS_CONCURRENCY=4

# Backups (docs/guides/backups.md): restore tests unpack in the container's /tmp.
PA_BACKUP_ENABLED=true
